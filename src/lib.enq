extern fn encore_vk_completion_clone(completion: usize) -> usize
extern fn encore_vk_completion_destroy(completion: usize) -> bool
extern fn encore_vk_completion_status(completion: usize) -> u32
/// Retained completion record; destroy each returned reference exactly once.
pub fn native_frame_completion(frame: usize) -> usize {
    ret encore_vk_frame_completion(frame)
}
pub fn native_completion_clone(completion: usize) -> usize {
    ret encore_vk_completion_clone(completion)
}
pub fn native_completion_destroy(completion: usize) -> bool {
    ret encore_vk_completion_destroy(completion)
}
/// 0 invalid, 1 pending, 2 complete, 3 cancelled, 4 fault (retain and retry).
pub fn native_completion_status(completion: usize) -> u32 {
    ret encore_vk_completion_status(completion)
}

