/// Copies a completed host-visible range. The caller owns GPU completion ordering.
#attr(safe)
pub fn native_buffer_read_f32s(handle: usize, offset: u64, count: usize) -> Vec[f32] {
    if count > 67108864_usize {
        ret Vec[f32]::new()
    }
    let mut values = Vec[f32]::with_capacity(count)
    for _index in 0_usize..count {
        values.push(0)
    }
    unsafe {
        if !encore_vk_buffer_read_f32s(handle, offset, values.as_ptr(), count) {
            values.clear()
        }
    }
    ret values
}
