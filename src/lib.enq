//! Vulkan resources, commands and externally managed presentation surfaces.
import core::vec::Vec

extern fn encore_vk_texture_borrow(device: usize, image: u64, width: u32, height: u32, format: u32, layout: u32) -> usize
extern fn encore_vk_frame_sampled_color_barrier(frame: usize) -> bool

/// Owns only a sampled view; the caller keeps the external image alive.
pub fn native_texture_borrow(device: usize, image: u64, width: u32, height: u32, format: u32, layout: u32) -> usize {
    unsafe {
        ret encore_vk_texture_borrow(device, image, width, height, format, layout)
    }
}
/// Orders earlier sampled-image reads before rendering into reused images.
pub fn native_frame_sampled_color_barrier(frame: usize) -> bool {
    unsafe {
        ret encore_vk_frame_sampled_color_barrier(frame)
    }
}

extern fn encore_vk_swapchain_wait(handle: usize) -> bool

/// Waits for submitted frames before accessing offscreen readback pixels.
pub fn native_swapchain_wait(handle: usize) -> bool {
    unsafe {
        ret encore_vk_swapchain_wait(handle)
    }
}

#attr(test)
fn empty_vulkan_handles_are_unavailable() -> bool {
    ret !native_available(0_usize) && !native_device_available(0_usize) &&
    !native_surface_available(0_usize) && !native_swapchain_available(0_usize)
}

extern fn encore_vk_create_named_extensions(debug: bool, names: str*, count: usize) -> usize
extern fn encore_vk_surface_borrow(context: usize, surface: u64, width: u32, height: u32) -> usize
extern fn encore_vk_surface_resize(handle: usize, width: u32, height: u32) -> bool

/// Creates an instance with the platform-required extension names, without loading a window toolkit.
pub fn native_create_with_extensions(debug: bool, extensions: Vec[str]) -> usize {
    unsafe {
        ret encore_vk_create_named_extensions(debug, extensions.as_ptr(), extensions.len())
    }
}

/// Borrows a VkSurfaceKHR. Destroy swapchains and this wrapper before destroying the external surface and instance.
pub fn native_surface_borrow(context: usize, surface: u64, width: u32, height: u32) -> usize {
    unsafe {
        ret encore_vk_surface_borrow(context, surface, width, height)
    }
}

/// Updates pixel dimensions after a platform resize event; zero dimensions represent a minimized surface.
pub fn native_surface_resize(handle: usize, width: u32, height: u32) -> bool {
    unsafe {
        ret encore_vk_surface_resize(handle, width, height)
    }
}

