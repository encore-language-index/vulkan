extern fn encore_vk_parallel_configure(workers: u32) -> bool
extern fn encore_vk_parallel_stat(device: usize, index: u32) -> u64

/// Configures CPU recording workers and a queue-owner thread for subsequently created devices.
/// Call before creating windows/devices; zero preserves synchronous execution.
pub fn native_parallel_configure(workers: u32) -> bool {
    unsafe {
        ret encore_vk_parallel_configure(workers)
    }
}
/// Cumulative backend counters: workers, recording ns, submission ns, packets, bytes, error.
pub fn native_parallel_stat(device: usize, index: u32) -> u64 {
    unsafe {
        ret encore_vk_parallel_stat(device, index)
    }
}

