import vulkan::PresentationSchedule
fn main() -> u32 {
    let mut queue = PresentationSchedule::new()
    if queue.pending() {
        ret 1
    }
    queue.begin(4, 1000000_u64, 2000000_u64)
    if !queue.due(2000000_u64) || queue.index() != 0 {
        ret 2
    }
    // Rejected/failed presentations leave the cursor unchanged.
    if queue.index() != 0 || queue.expired(2000000_u64) {
        ret 3
    }
    queue.submitted(2000000_u64)
    if queue.index() != 1 || queue.due(2999999_u64) || !queue.due(3000000_u64) {
        ret 4
    }
    queue.submitted(3000000_u64) queue.submitted(4000000_u64) queue.submitted(5000000_u64)
    if queue.pending() {
        ret 5
    }
    queue.begin(2, 0_u64, 1000000_u64)
    if !queue.expired(101000001_u64) {
        ret 6
    }
    queue.cancel() if queue.pending() {
        ret 7
    }
    queue.begin(9, 1000000_u64, 1000000_u64) if queue.pending() {
        ret 8
    }
    ret 0
}
